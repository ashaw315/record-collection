# Test-only environment for Playwright E2E runs. Committed deliberately: these
# are throwaway credentials for a local dev server and never reach a deployed
# environment.
#
# Next.js loads this file when NODE_ENV=test and, importantly, does NOT load
# .env.local in that mode. That isolation is the point: without it an E2E run
# authenticates against the developer's own APP_PASSWORD_HASH and fails.

# bcrypt hash of "test-password-for-e2e"
# Each `$` is escaped as `\$`: Next expands $VAR references in env values after
# loading, which silently truncates an unescaped bcrypt hash from 60 chars to 46.
APP_PASSWORD_HASH=\$2b\$10\$O9DoLjk.2ChWgpUOo1zzXupRQlLwmvdFCxPxTkNab5YtAORj09Siy
SESSION_SECRET=e2e-session-secret-at-least-32-characters-long
CRON_SECRET=e2e-cron-secret-at-least-32-characters-long
DISCOGS_TOKEN=e2e-discogs-token
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/record_collection_test

# Present so resolveDriver selects the local Docker Postgres rather than
# throwing under NODE_ENV=test (SPEC.md §2).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/record_collection_test
