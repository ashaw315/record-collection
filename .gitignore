# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
# Transient stash used by test/repo/drizzle-config.test.ts, which hides
# .env.local so .env.test is provably the only source of the test database URL.
# Restored in a finally block; ignored here so a crashed run leaves nothing
# committable.
.env.local.drizzle-config-test-stash

# vercel
.vercel

# typescript
*.tsbuildinfo

# editor
.idea/
.vscode/*
!.vscode/extensions.json

# drizzle
# Transient config written by test/repo/migrations-complete.test.ts. It is
# removed in afterAll, but ignored here so a crashed run cannot leave a
# committable orphan in the repo root.
drizzle.config.fresh-clone-test.ts

# Nothing under /drizzle is ignored. drizzle/meta/_journal.json and the
# per-migration snapshots are migration state, not build output: `drizzle-kit
# migrate` reads the journal to decide what to apply, and without it a fresh
# clone silently applies zero migrations and exits 0.
.next-test

# Scratch space for one-off handoffs — never repo content.
#
# `scratch/design-handoff/` holds the design brief exported for attaching to a
# design tool, which cannot read the artifact URL (it renders client-side behind
# a session). The artifact at claude.ai/code/artifact/4c24fa29 remains the
# canonical copy; these are disposable exports of it.
#
# Ignored rather than merely untracked so a `git add -A` cannot sweep them in.
scratch/

# Ad-hoc database probes written at the repo root to query production.
#
# Module resolution forces them here rather than into the scratchpad — `@/`
# aliases and `dotenv` only resolve inside the project — so they sit beside
# tracked files and `git add -A` sweeps them in. That happened: `q-probe.mjs`
# reached commit 1315709, was then deleted, and `dotenv-quiet.test.ts` failed
# reading a tracked file that no longer existed.
#
# Ignored rather than merely remembered, for the reason `scratch/` above gives.
q-probe.mjs
*-probe.mjs
