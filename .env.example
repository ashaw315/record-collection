# Copy to .env.local and fill in. Every variable below is read server-side only
# and validated at boot (SPEC.md §2) — a missing required one fails startup with
# a message naming it.

# --- Required ---------------------------------------------------------------

# Neon Postgres connection string. Must be postgresql:// or postgres://.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/recorddb?sslmode=require

# bcrypt hash of the single shared app password (SPEC.md §3). This is the hash,
# never the password itself.
#
# IMPORTANT: escape every `$` as `\$` IN THIS FILE. Next.js expands $VAR
# references in env values, which silently truncates an unescaped bcrypt hash
# from 60 characters to 46 and makes every login fail with "Incorrect password".
# Both halves of that were measured (NOTES.md, "presence is not shape"):
# unescaping this value makes `next dev` fail to boot, and dotenv — which
# drizzle-kit uses — does NOT expand, so it reads `\$` as two literal
# characters. The escaping is specific to the loader, not universal.
#
# Boot validation now rejects anything that is not a 60-character bcrypt hash,
# so this fails loudly at startup instead of as a permanently wrong password.
#
# Values set in the Vercel dashboard are not expanded and need no escaping —
# paste the raw 60-character hash there.
#
# Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" 'your-password'
APP_PASSWORD_HASH=\$2b\$12\$replace.this.with.a.real.bcrypt.hash.value.0123456789

# Signing key for the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# Bearer token Vercel Cron sends to /api/discogs/refresh-prices (SPEC.md §3).
# At least 32 characters. Generate with: openssl rand -base64 32
CRON_SECRET=replace-with-at-least-32-random-characters

# Discogs personal access token (SPEC.md §6).
# Create one at https://www.discogs.com/settings/developers
DISCOGS_TOKEN=your-discogs-personal-access-token

# --- Optional ---------------------------------------------------------------

# Anthropic API key for the LLM suggestion engine (SPEC.md §9.2).
# Not needed until build step 12; the dev server starts without it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Vercel Blob token for record image uploads (SPEC.md §5.9).
# Not needed until build step 8; the dev server starts without it.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# Local Postgres test database provided by docker-compose.yml. Used instead of
# DATABASE_URL when NODE_ENV=test (CLAUDE.md §2). Start it with `npm run db:test:up`.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/record_collection_test
